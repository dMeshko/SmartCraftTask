# syntax=docker/dockerfile:1
#
# Build context: repository root
#
#   docker build -f src/SmartCraftTask/Dockerfile.Migrations -t smartcrafttask-migrations .
#   docker run --rm -e ConnectionString="Server=..." smartcrafttask-migrations
#
# The same service binary as the API, started with --migrate: it applies the schema, plants the
# sample aggregates if the database is empty, and exits 0 — or logs and exits 1, which is what holds
# the API back, since compose waits for this container to complete successfully.
#
# Not an `ef migrations bundle` as the Scheduling service uses. A bundle applies migrations and
# nothing else, and the sample data here is planted through the aggregate rather than written as
# rows, so a bundle could not produce it. The trade is a larger image for this job — the service
# rather than a standalone migrator — in exchange for the seed staying domain-driven.
#
# The restore and publish stages match Dockerfile's. That is duplication, but it keeps each file
# buildable on its own, and buildx caches by content so the layers are shared rather than rebuilt.

###############################################
# Stage 1 — restore
###############################################
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS restore

ARG TARGETARCH

ENV NUGET_HTTP_CACHE_PATH=/root/.local/share/NuGet/http-cache
ENV NUGET_PLUGINS_CACHE_PATH=/root/.local/share/NuGet/plugins-cache

WORKDIR /src

COPY Directory.Build.props Directory.Packages.props ./
COPY src/SmartCraftTask/SmartCraftTask.csproj src/SmartCraftTask/

RUN --mount=type=cache,sharing=locked,target=/root/.nuget/packages \
    --mount=type=cache,sharing=locked,target=/root/.local/share/NuGet/http-cache \
    --mount=type=cache,sharing=locked,target=/root/.local/share/NuGet/plugins-cache \
    RID="linux-musl-$([ "$TARGETARCH" = arm64 ] && echo arm64 || echo x64)" \
    && echo "$RID" > /tmp/rid \
    && dotnet restore src/SmartCraftTask/SmartCraftTask.csproj -r "$RID" --nologo

###############################################
# Stage 2 — publish
###############################################
FROM restore AS publish

ARG BUILD_CONFIGURATION=Release

COPY src/ ./src/

RUN --mount=type=cache,sharing=locked,target=/root/.nuget/packages \
    --mount=type=cache,sharing=locked,target=/root/.local/share/NuGet/http-cache \
    --mount=type=cache,sharing=locked,target=/root/.local/share/NuGet/plugins-cache \
    dotnet publish src/SmartCraftTask/SmartCraftTask.csproj \
        -c "$BUILD_CONFIGURATION" \
        -r "$(cat /tmp/rid)" \
        --self-contained true \
        --no-restore \
        --output /publish

###############################################
# Stage 3 — runtime only. No curl and no exposed port: this container answers nothing, it runs
#           once and exits.
###############################################
FROM mcr.microsoft.com/dotnet/runtime-deps:10.0-alpine AS final

RUN apk upgrade --no-cache \
    && apk add --no-cache icu-libs

ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

WORKDIR /app
COPY --from=publish /publish .

USER 1000:1000

ENTRYPOINT ["/app/SmartCraftTask", "--migrate"]
